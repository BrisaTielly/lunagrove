{
  "name": "lunagrove",
  "private": true,
  "version": "0.2.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "test": "vitest",
    "test:watch": "vitest",
    "typecheck": "tsc -b --pretty false",
    "package": "tsc -b && vite build && rm -f lunagrove-$npm_package_version.zip && cd dist && zip -qr ../lunagrove-$npm_package_version.zip .",
    "gallery": "vite --open /src/dev/gallery.html"
  },
  "dependencies": {
    "@crxjs/vite-plugin": "^3.0.0",
    "@fontsource-variable/pixelify-sans": "^5.3.0",
    "@fontsource/jersey-10": "^5.3.0",
    "@fontsource/silkscreen": "^5.3.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/chrome": "^0.3.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "jsdom": "^30.1.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "vitest": "^5.0.2"
  }
}
